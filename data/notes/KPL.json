{
 "as_of": "2026-10-05",
 "descriptor": "Injectables and generics exporter",
 "lede": "An Amritsar-based exporter of injectables and generics to Latin America, Africa and the Gulf, now chasing regulated markets, hormones and biosimilars. It hits its numbers, but cash lags profit, receivables are long, and governance questions are piling up.",
 "market": {
  "price": 3564,
  "mcap_cr": 3698,
  "pe": 45.3,
  "pb": 11.1,
  "ev_ebitda": 28
 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "Revenue up 36% in FY26 to ₹503 Cr with PAT up 69% to ₹67 Cr; Q1 FY27 (₹162 Cr) met its quarterly guidance, and FY27 guidance was raised to ₹700–720 Cr. ROCE improved to 24%."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Operating cash flow was ₹17 Cr against ₹67 Cr of profit, with debtor days at 203. The big-four auditor appointment keeps slipping, a related-party land deal was questioned on the call, and five family directors got 16–20% pay rises."
  },
  {
   "lead": "Price",
   "text": "45x trailing earnings vs 12x for Lincoln and 30x for Caplin Point, a richer multiple than its cash flow supports."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Kwality makes injectables (oncology, general, beta-lactam, cephalosporin) and oral generics in five plants, selling through partners and government tenders in Mexico, Colombia, Algeria and the wider MENA, GCC, CIS and Southeast Asia. A hormone plant starts in November 2026; biosimilars (EPO, Pembrolizumab) are in trials.",
     "src": "Aug call p.3"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "~20–25%",
       "label": "Oncology share of revenue (₹100–130 Cr)"
      },
      {
       "value": "60–70",
       "label": "Registrations won in three quarters"
      },
      {
       "value": "$1.5–2m",
       "label": "Yearly sales per registration"
      },
      {
       "value": "~85%",
       "label": "Raw materials sourced in India"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Margins come from first and second generics of off-patent molecules: 40–45% EBITDA early, falling to 25–30%.",
       "src": "May call p.10"
      },
      {
       "lead": "",
       "text": "Peptide oncology products earn about 40%; routine oncology about 25%.",
       "src": "May call p.5"
      },
      {
       "lead": "",
       "text": "Tender markets (Algeria, MENA) pay well but on full credit, which ties up cash.",
       "src": "May call p.10"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Revenue fell from ₹456 Cr (FY22, COVID boost) to ₹251 Cr, then rebuilt to ₹503 Cr.",
       "src": null
      },
      {
       "lead": "",
       "text": "Moving from unregulated to regulated markets (first German registrations).",
       "src": null
      },
      {
       "lead": "",
       "text": "New units: hormones (₹65 Cr capex), oncology expansion (₹50 Cr), biologics (Unit 5).",
       "src": null
      }
     ]
    }
   ]
  },
