 "short_version": [
  {
   "lead": "What's going right",
   "text": "Revenue grew from ₹215 Cr (FY24) to ₹633 Cr (FY26) with EBITDA margin rising to 27%; FY26 beat guidance (62% revenue growth vs 50% guided, 108% PAT growth vs 100%). Q1 FY27 kept pace with the 30–40% / 50–60% guidance."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Five-year operating cash flow is –₹21 Cr against ₹222 Cr of profit. Profit share is booked before cash arrives (₹172 Cr of 'other financial assets'). IPO money was moved from a sterile injectables plant to oral solids, and the branded-generics target was cut."
  },
  {
   "lead": "Price",
   "text": "49x trailing earnings vs 29–30x for Marksans and Caplin Point, which have longer records and better cash conversion."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Senores develops and makes generic medicines for the US and other regulated markets, both its own ANDAs and contract work (CDMO-CMO), plus emerging-market exports and a small India branded-generics business. Plants: Atlanta (US), Chhatral (Ahmedabad) and the recently acquired USFDA-approved Apnar plant in Baroda.",
     "src": "May call p.4"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "58",
       "label": "Approved ANDAs (23 launched), Jun 2026"
      },
      {
       "value": "~70 / 30",
       "label": "Regulated / emerging markets revenue"
      },
      {
       "value": "50–53%",
       "label": "Own products; rest CDMO-CMO"
      },
      {
       "value": "₹180 Cr",
       "label": "Emerging-markets revenue target, FY27"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "US EBITDA margins run around 40%; emerging markets 18–20%; branded generics aim for 35–40%.",
       "src": "May call p.17"
      },
      {
       "lead": "",
       "text": "Acquired ANDAs are cheaper to launch than developing new ones, so margins depend on finding and launching them.",
       "src": "May call p.16"
      },
      {
       "lead": "",
       "text": "Profit-share arrangements with partners mean part of income comes months after sale.",
       "src": "May call p.9"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Listed in December 2024; ANDA count went from 22 to 58 in 15 months, mostly by acquisition.",
       "src": null
      },
      {
       "lead": "",
       "text": "Bought 75% of Apnar Pharma (Q4 FY26), Zoraya (US front end) and set up Amerisyn (US government JV).",
       "src": null
      },
      {
       "lead": "",
       "text": "Moved IPO money from a new sterile plant to oral-solid capacity (pending shareholder approval).",
       "src": "Aug call p.10"
      }
     ]
    }
   ]
  },
