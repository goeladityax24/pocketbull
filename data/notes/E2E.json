  "ev_ebitda": 58
 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "Q1 FY27 revenue ₹157 Cr (+334%), EBITDA ₹118 Cr (75%) and PAT ₹44 Cr after the first 1,024 B200 GPUs went live near full use; GPU rental prices are rising and another 1,024 B200s are coming."
  },
  {
   "lead": "What to be sceptical about",
   "text": "FY26 free cash flow was –₹1,140 Cr and depreciation (₹169 Cr) wiped out profit; debt is rising (~₹450 Cr). The uses of ₹1,485 Cr of preferential issue money were changed and pledging of unused proceeds authorised; no revenue or MRR guidance."
  },
  {
   "lead": "Price",
   "text": "433x trailing earnings and ~58x trailing EV/EBITDA; on Q1 annualised profit about 77x."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "E2E Networks runs a cloud platform in India that rents GPU (NVIDIA H100, H200, B200) and CPU capacity by the hour, month or year, with its TIR and Jarvis Labs software for training, fine-tuning and inference. Customers are AI start-ups and LLM teams, enterprises, India AI Mission users and international clients (~37%). L&T owns 18.45% and partners on data centres.",
     "src": "Jul call p.3"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "~5,100",
       "label": "GPUs live (another 1,024 B200 due)"
      },
      {
       "value": "75.2%",
       "label": "EBITDA margin, Q1 FY27"
      },
      {
       "value": "~37%",
       "label": "International share of revenue"
      },
      {
       "value": "18.45%",
       "label": "L&T stake, March 2026"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Margins come from high utilisation of owned GPUs; costs are mostly fixed (depreciation over 6 years, power).",
       "src": "Apr call p.11"
      },
      {
       "lead": "",
       "text": "Mix of hourly, monthly and multi-year contracts; customers now taking 1-3 year terms to lock prices.",
       "src": "Jul call p.11"
      },
      {
       "lead": "",
       "text": "Depreciation is the main cost below EBITDA, so profit depends on keeping GPUs busy.",
       "src": "Apr call p.5"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Moved from NSE Emerge to the main board; raised ~₹1,485 Cr through preferential issues including L&T.",
       "src": "AR p.75"
      },
      {
       "lead": "",
       "text": "Fixed assets rose from ₹42 Cr (FY23) to ₹1,036 Cr plus ₹533 Cr CWIP (FY26).",
       "src": null
      },
      {
       "lead": "",
       "text": "New subsidiaries: SovCloud (infrastructure) and a Delaware company for international sales.",
       "src": "Jul call p.7"
      }
     ]
    }
   ]
  },
