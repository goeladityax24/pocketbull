 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "Steady 18% growth for four years, EBITDA margin up to 23%, debt-free; skids went from zero to ₹32 Cr a quarter (23% of revenue) within a year, and capacity is going to 15,000 skids a year."
  },
  {
   "lead": "What to be sceptical about",
   "text": "All skid sales go to one US cooling company's Indian arm under an exclusive deal, with only two months of visibility. Return on new capital has dropped to ~7% as depreciation jumped, and a ₹40 Cr tax demand is under appeal."
  },
  {
   "lead": "Price",
   "text": "107x trailing earnings and ~61x EV/EBITDA, far above Uniparts (20x), Harsha (27x) and Shivalik Bimetal (58x)."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Aeroflex makes corrugated stainless-steel flexible hoses, braiding and hose assemblies, metal bellows and (through Hyd-Air) fittings at Taloja, Navi Mumbai. In FY26 it began making SFN skid assemblies that circulate coolant in liquid-cooled AI data centres, supplied exclusively to the India arm of a US-headquartered cooling company.",
     "src": "May call p.6"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "~60%",
       "label": "Exports share of revenue (75-80% of hose assemblies)"
      },
      {
       "value": "25-26%",
       "label": "Largest export customer's share of sales"
      },
      {
       "value": "9,000 → 15,000",
       "label": "Skid capacity a year, by Oct-Nov 2026"
      },
      {
       "value": "₹3-3.25 lakh",
       "label": "Average price per skid"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Assemblies earn 22-26% margin vs 16-20% for plain hose; assemblies are 63% of hose revenue.",
       "src": "Jul call p.5"
      },
      {
       "lead": "",
       "text": "Skids earn about the company-average margin; bellows the highest but still sub-scale.",
       "src": "Jul call p.9"
      },
      {
       "lead": "",
       "text": "Landed cost 25-30% below local suppliers in export markets.",
       "src": "May call p.16"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "IPO in 2023; parent is Aeroflex Enterprises (formerly Sat Industries).",
       "src": "AR p.131"
      },
      {
       "lead": "",
       "text": "Bought Hyd-Air (fittings) and started metal bellows; miniature-bellows capex redirected to liquid cooling.",
       "src": "May call p.13"
      },
      {
       "lead": "",
       "text": "Skids: 617 units in Q4 FY26, 1,040 in Q1 FY27.",
       "src": "Jul call p.13"
      }
     ]
    }
   ]
  },
