 "short_version": [
  {
   "lead": "What's going right",
   "text": "FY26 revenue doubled to ₹148–153 Cr with 22.5% EBITDA and 14% net margin; H2 FY26 revenue was up 164%. BIS-ER certification, 11,000+ dealers and in-house PCB manufacturing position it for the STQC era."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Operating cash flow was ₹0.3 Cr against ₹21 Cr of profit; short-term debt rose from ₹2.8 Cr to ₹31.8 Cr. A ₹10 Cr long-term advance and ₹12 Cr of intangibles under development are unexplained. There are no calls and no guidance to hold management to."
  },
  {
   "lead": "Price",
   "text": "65x trailing earnings and 18x book, versus CP PLUS at 103x but with a far weaker market position."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Prizor sells Prizor-brand CCTV cameras (IP, analog, 4G, AI) assembled in Gandhinagar, plus LED TVs, monitors and touch panels made by partners, through 11,000+ dealers in 21 states. CCTV was ₹114 Cr and displays ₹24 Cr of FY26 revenue.",
     "src": "Apr deck p.25"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "16 lakh",
       "label": "Camera assembly capacity a year (expandable to 40 lakh)"
      },
      {
       "value": "11,000+",
       "label": "Dealers (5,200 in FY24)"
      },
      {
       "value": "₹92 Cr",
       "label": "CCTV revenue in H2 FY26 alone"
      },
      {
       "value": "–51%",
       "label": "Display products revenue, H2 FY26"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Margin is the brand premium on assembled cameras sold through dealers; in-house PCB and housing moulding should lift it.",
       "src": "Apr deck p.14"
      },
      {
       "lead": "",
       "text": "Demand jumped when STQC certification became mandatory for CCTV sold in India.",
       "src": "Apr deck p.35"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Founded 2017; listed on NSE SME in 2024; revenue from ₹14 Cr (FY23) to ₹148 Cr (FY26).",
       "src": null
      },
      {
       "lead": "",
       "text": "Shift from TVs and displays to cameras as STQC rules took effect.",
       "src": null
      }
     ]
    }
   ]
  },
