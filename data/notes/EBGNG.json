{
 "as_of": "2026-10-05",
 "descriptor": "Refurbished laptops and desktops (Electronics Bazaar)",
 "lede": "A global refurbisher of business laptops that is riding a memory-chip shortage: new PCs got 40-57% dearer in six months, sending buyers to its warrantied refurbished machines. Profits doubled and guidance keeps rising, but growth eats cash and margins lean on inventory bought before prices rose.",
 "market": {
  "price": 695,
  "mcap_cr": 7924,
  "pe": 55.6,
  "pb": 10.5,
  "ev_ebitda": 39
 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "Revenue +34% to ₹1,891 Cr and PAT nearly doubled to ₹132 Cr in FY26, beating guidance; Q1 FY27 gross margin jumped to 24.7%, and guidance was raised to 30% growth with PAT margin up 75-100 bps."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Operating cash flow was negative in FY25 and FY26 (–₹215 Cr) as inventory rose to ~₹700-740 Cr; net debt rose to ₹406 Cr in Q1 despite the IPO. Part of the margin gain is inventory profit in a price boom management expects to last until early 2028."
  },
  {
   "lead": "Price",
   "text": "56x trailing earnings and ~39x EV/EBITDA; IT distributors Redington and Rashi trade near 18-20x, but at 2-3% margins."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "GNG buys used business laptops and desktops in bulk from banks, leasing firms and corporates, refurbishes them in Mumbai and the UAE, and sells them under the 'Electronics Bazaar' brand with 1-3 year warranties to dealers, distributors, enterprises and schools in 49 countries.",
     "src": "Aug call p.5"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "727,000",
       "label": "Units sold in FY26 (~81% laptops)"
      },
      {
       "value": "~₹30,700",
       "label": "Laptop average price, Q1 FY27 (+12% YoY)"
      },
      {
       "value": "49",
       "label": "Countries; 5,130 customer touchpoints"
      },
      {
       "value": "~150,000",
       "label": "Units a month refurbishing capacity"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Buys whole lots (e.g. 60,000 desktops from a US bank) cheaply and sells with warranty at ~30% of new-PC prices.",
       "src": "Aug call p.14"
      },
      {
       "lead": "",
       "text": "International gross margin near 30% vs 21% in India.",
       "src": "Aug call p.8"
      },
      {
       "lead": "",
       "text": "Asset-light (few fixed assets) but working-capital heavy.",
       "src": "May call p.4"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "IPO in July 2025; revenue from ₹519 Cr (FY22) to ₹1,891 Cr (FY26).",
       "src": null
      },
      {
       "lead": "",
       "text": "National distributors Redington, Ingram Micro and Supertron signed in 2026.",
       "src": "Aug call p.14"
      },
      {
       "lead": "",
       "text": "UAE facilities grew from three to eight.",
       "src": "May call p.15"
      }
     ]
    }
   ]
  },
