{
 "as_of": "2026-10-05",
 "descriptor": "Pharma intermediates, CDMO and battery chemicals",
 "lede": "A Surat chemist (formerly Ami Organics) whose profits more than doubled on one big CDMO contract for a prostate-cancer drug. Management has a long record of ~25% growth and is now building battery-additive and semiconductor-chemical arms, but the stock prices in a lot of that.",
 "market": {
  "price": 3122,
  "mcap_cr": 25572,
  "pe": 66.2,
