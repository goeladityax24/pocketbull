 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "FY26 revenue +33% to ₹1,339 Cr, EBITDA margin up to 36% and PAT ₹356 Cr; Q1 FY27 revenue +59%. Debt-free, ROCE 32%, and a contracted battery-additive plant now supplying."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Much of the jump comes from one CDMO anchor product, and the company won't split CDMO from the rest. Inventory days rose to 149 and free cash flow has been negative five years running as capex rises."
  },
  {
   "lead": "Price",
   "text": "66x trailing earnings and ~47x EV/EBITDA, above Neuland (56x) and Navin Fluorine (53x)."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Acutaas makes advanced pharmaceutical intermediates for generic and innovator drug makers (87% of FY26 revenue), including CDMO work where it is the primary supplier of an intermediate for darolutamide (Nubeqa, sold by Bayer, made by Orion/Fermion). Its specialty-chemicals arm makes battery electrolyte additives (VC, FEC) and, through Baba Fine Chemicals, semiconductor photoresist chemicals; a Korean JV (Indichem) is being built.",
     "src": "Jul call p.14"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "87 / 13",
       "label": "Pharma / specialty chemicals, FY26 revenue"
      },
      {
       "value": "600+",
       "label": "Customers; 100+ products"
      },
      {
       "value": "4,000 t",
       "label": "VC + FEC battery-additive capacity, contracted for 3 years"
      },
      {
       "value": "₹1,000 Cr",
       "label": "CDMO revenue target for FY28"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "High-value intermediates and CDMO earn ~36-44% EBITDA; specialty chemicals 24-29%.",
       "src": "Jul call p.6"
      },
      {
       "lead": "",
       "text": "Portfolio reshuffled in FY26 to drop low-margin intermediates; commodity chemicals being phased out in FY27.",
       "src": "Jul call p.9"
      },
      {
       "lead": "",
       "text": "Strong seasonality: H1 is ~40% of the year, Q4 always the strongest.",
       "src": "May call p.6"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Renamed from Ami Organics; revenue from ₹520 Cr (FY22) to ₹1,339 Cr (FY26).",
       "src": null
      },
      {
       "lead": "",
       "text": "Bought Baba Fine Chemicals (semiconductor chemicals) and set up the Jhagadia battery-chemicals site.",
       "src": null
      },
      {
       "lead": "",
       "text": "₹190 Cr put into the Indichem JV in Korea in FY26.",
       "src": "May call p.5"
      }
     ]
    }
   ]
  },
