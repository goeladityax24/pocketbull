 "short_version": [
  {
   "lead": "What's going right",
   "text": "API revenue ₹442 Cr in H1 (+11%) at about 30% EBITDA margin, a signed US injectables agreement with milestone payments, and take-or-pay contracts for alternative protein and insulin capacity."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Over 90% of revenue is still API; new businesses cost ₹57 Cr of opex and ₹24 Cr of depreciation in H1 with little revenue, net debt is about ₹314 Cr and ROCE is 13%."
  },
  {
   "lead": "Price",
   "text": "66x earnings and 42x EBITDA price in the new businesses before they earn."
  }
