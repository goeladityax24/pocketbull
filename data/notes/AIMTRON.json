{
 "as_of": "2026-10-05",
 "descriptor": "Electronics design and manufacturing (SME)",
 "lede": "A fast-growing electronics manufacturer moving from circuit-board assembly to design and full box builds, now with a US acquisition. Growth and margins are strong, but cash has gone out every year and guidance doesn't add up.",
 "market": {
  "price": 1876,
  "mcap_cr": 3990,
  "pe": 86.8,
  "pb": 16.5,
  "ev_ebitda": 66
 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "Revenue nearly doubled to ₹301 Cr in FY26 (beating its ₹250–280 Cr guidance) with a steady 20–23% EBITDA and 15% net margin; order book about ₹600 Cr; certifications for aerospace, MedTech, automotive and telecom."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Operating cash flow was negative two years running (–₹40 Cr in FY26) as inventory and receivables ballooned. The new US subsidiary runs at about 11% EBITDA, and management admitted its FY27 numbers don't reconcile."
  },
  {
   "lead": "Price",
   "text": "87x trailing earnings for an SME company, in line with Syrma (88x) and below Avalon (114x), but with negative cash flow."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Aimtron designs and manufactures electronics: PCB assembly, box build and full products to order (ODM), from Vadodara and Bangalore, plus a newly acquired plant in Decatur, Illinois (AIC). Customers include a Fortune 500 US data-centre firm, telecom, power, industrial, drone and defence PSU clients.",
     "src": "Apr call p.3"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "~₹600 Cr",
       "label": "Group order book, Apr 2026"
      },
      {
       "value": "70 / 30",
       "label": "Domestic / export revenue"
      },
      {
       "value": "9",
       "label": "SMT lines; capacity about ₹800–900 Cr revenue"
      },
      {
       "value": "~11%",
       "label": "EBITDA margin at the acquired US unit"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Margins hold at 20–22% EBITDA by picking complex, low-volume, high-mix boards (MedTech, power electronics, telecom).",
       "src": "Apr call p.20"
      },
      {
       "lead": "",
       "text": "Box build raises order value; ODM design work earns the most but is under 5% of revenue.",
       "src": "Apr call p.11"
      },
      {
       "lead": "",
       "text": "Input costs are passed on to customers; chip shortages are the main supply risk.",
       "src": "Apr call p.7"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Listed on NSE SME in 2024; revenue went from ₹93 Cr (FY24) to ₹301 Cr (FY26).",
       "src": null
      },
      {
       "lead": "",
       "text": "Preferential shares and warrants in FY26 to fund a greenfield plant.",
       "src": null
      },
      {
       "lead": "",
       "text": "Bought ICS (now AIC) in the US in FY26; plans to move to the main board after three years.",
       "src": null
      }
     ]
    }
   ]
  },
