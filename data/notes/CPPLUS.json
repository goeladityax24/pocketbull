{
 "as_of": "2026-10-05",
 "descriptor": "Video surveillance market leader (CP PLUS)",
 "lede": "India's largest video-surveillance company, which roughly doubled its market share as STQC rules pushed out Chinese brands. Execution is excellent, but cash has lagged profit, half of this year's growth is price, and the stock trades at about 100x earnings.",
 "market": {
  "price": 3989,
  "mcap_cr": 48917,
  "pe": 103,
  "pb": 25.1,
  "ev_ebitda": 69
 },
 "short_version": [
  {
   "lead": "What's going right",
   "text": "FY26 revenue up 36% to ₹4,221 Cr with EBITDA up 124%; Q1 FY27 revenue up 89.5% to ₹1,402 Cr at a 14.8% EBITDA margin, ahead of the ₹6,000–6,500 Cr FY27 guidance. Market share about 43–45%; debt/equity just 0.07."
  },
  {
   "lead": "What to be sceptical about",
   "text": "Five-year operating cash flow is –₹40 Cr against ₹1,039 Cr of profit. Q4 FY26's 18% margin was helped by cheap inventory now used up, prices are being raised 10–25% as chip costs climb, and 40+ brands are now certified. New plants slipped a quarter or two."
  },
  {
   "lead": "Price",
   "text": "About 100x trailing and ~87x FY27 earnings: the market cap already exceeds most bull cases three years out."
  }
 ],
 "sections": [
  {
   "id": "business",
   "title": "Company overview and business model",
   "blocks": [
    {
     "type": "text",
     "text": "Aditya Infotech sells CP PLUS surveillance cameras, recorders and AI solutions (87% of revenue), plus distributed brands. Manufacturing is at Kadapa (2.5 million units a month), with housings, cables and lenses being brought in-house and a second cluster planned in Greater Noida.",
     "src": "Aug call p.3"
    },
    {
     "type": "tiles",
     "items": [
      {
       "value": "~43–45%",
       "label": "Share of India's surveillance market"
      },
      {
       "value": "79%",
       "label": "IP products in CP PLUS sales, Q1 FY27"
      },
      {
       "value": "85–90%",
       "label": "Capacity utilisation"
      },
      {
       "value": "15–20%",
       "label": "Revenue from government projects"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "Where the profit comes from",
     "items": [
      {
       "lead": "",
       "text": "Gross margin about 31% from brand premium, IP mix and localisation; Q4 FY26 was boosted by cheap inventory.",
       "src": "May call p.8"
      },
      {
       "lead": "",
       "text": "Chips (35% of bill of materials) come from Taiwan; price rises are passed on monthly with a lag.",
       "src": "Aug call p.11"
      },
      {
       "lead": "",
       "text": "Forex is hedged 85–100%.",
       "src": "Aug call p.12"
      }
     ]
    },
    {
     "type": "bullets",
     "title": "What changed in 3–5 years",
     "items": [
      {
       "lead": "",
       "text": "Listed in August 2025; IPO money repaid debt (debt/equity from 1.03x to 0.14x).",
       "src": null
      },
      {
       "lead": "",
       "text": "STQC rules (April 2025) barred Chinese chips; market share went from about 25% (own brand) to 43–45%.",
       "src": "May call p.3"
      },
      {
       "lead": "",
       "text": "Partnerships with Qualcomm and L&T Semiconductor; cable JV with Orient Cables.",
       "src": null
      }
     ]
    }
   ]
  },
