# Copy to .env.local (git-ignored) and fill in. The same go in Vercel › Settings › Environment Variables.

# Supabase › Project Settings › Data API (URL) and API Keys (secret key). Server only.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Passphrase that unlocks editing on /admin. Leave unset locally to edit without one.
ADMIN_KEY=
# Name shown on your tags, notes and links
ADMIN_NAME=Anushka

# Optional: fine-grained GitHub token (Issues: read and write on the repo) so requests open an issue
GITHUB_TOKEN=
GITHUB_REPO=goeladityax24/pocketbull

# Optional: paid API path (npm run analyze)
ANTHROPIC_API_KEY=
